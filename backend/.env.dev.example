# Development-only configuration. Copy this file to .env.dev and keep the
# resulting file local; .env.dev is intentionally ignored by Git.
DEBUG=true
APP_ENV=dev
BACKEND_PORT=8001

# Generate a unique random value for every environment.
SECRET_KEY=please_replace_with_a_unique_random_secret
MODEL_CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
KNOWLEDGE_JOB_STALE_MINUTES=120

DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/product_knowledge_dev
REDIS_URL=redis://localhost:6379/1
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
CORS_ORIGINS=http://localhost:5276,http://127.0.0.1:5276
CELERY_QUEUE=celery_dev
CELERY_WORKER_NAME=worker_dev
LOG_DIR=logs/dev
UPLOAD_DIR=uploads_dev

DMXAPI_BASE_URL=https://www.dmxapi.cn
DMXAPI_API_KEY=
DASHSCOPE_API_KEY=
ALLOW_PRIVATE_MODEL_ENDPOINTS=false
ALLOW_INSECURE_MODEL_ENDPOINTS=false

# Use a unique development password; never copy this value to production.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=please_replace_with_a_unique_development_password
